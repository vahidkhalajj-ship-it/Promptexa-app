<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Promptexa" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/promptexa_primary</item>
        <item name="colorPrimaryDark">@color/promptexa_primary_dark</item>
        <item name="colorAccent">@color/promptexa_accent</item>
        <item name="android:statusBarColor">@color/promptexa_primary</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <style name="Theme.Promptexa.Splash" parent="Theme.Promptexa">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
    </style>
</resources>
